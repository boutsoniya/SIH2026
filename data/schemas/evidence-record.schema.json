{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NARCOSCOPE Evidence Record",
  "type": "object",
  "required": [
    "test_id",
    "operator_id",
    "timestamp",
    "test_type",
    "result",
    "image_sha256",
    "record_hash"
  ],
  "properties": {
    "test_id": {
      "type": "string"
    },
    "operator_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "gps": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "accuracy_m": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "test_type": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "enum": [
        "PRESUMPTIVE_POSITIVE",
        "PRESUMPTIVE_NEGATIVE",
        "INCONCLUSIVE"
      ]
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "image_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "record_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "signature": {
      "type": [
        "string",
        "null"
      ]
    },
    "card_geometry": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "source": {
          "type": "string"
        },
        "coordinate_space": {
          "type": "string"
        },
        "card_corners": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 4,
          "maxItems": 4
        },
        "homography": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "minItems": 3,
          "maxItems": 3
        },
        "color_calibration": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "status": {
              "type": "string"
            },
            "method": {
              "type": "string"
            },
            "profile_id": {
              "type": "string"
            },
            "patches_used": {
              "type": "integer"
            },
            "rmse": {
              "type": "number"
            }
          }
        },
        "normalized_size": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "reaction_roi": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "calibration": {
      "type": [
        "object",
        "null"
      ]
    },
    "aruco": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "verified": {
          "type": "boolean"
        },
        "dictionary": {
          "type": "string"
        },
        "expected_ids": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "detected_ids": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "matched_ids": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "pre_lab_readiness": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "READY",
            "REVIEW_REQUIRED",
            "RECAPTURE_REQUIRED"
          ]
        },
        "ready_for_handoff": {
          "type": "boolean"
        },
        "checks": {
          "type": "object"
        },
        "next_action": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "ready_for_handoff",
        "checks",
        "next_action",
        "note"
      ]
    },
    "quality": {
      "type": [
        "object",
        "null"
      ]
    },
    "capture_device": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "user_agent": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "language": {
          "type": "string"
        }
      }
    },
    "chain_of_custody": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event",
          "timestamp",
          "actor"
        ],
        "properties": {
          "event": {
            "type": "string",
            "enum": [
              "CAPTURED",
              "SEALED",
              "SYNCED",
              "REVIEWED"
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "type": "string"
          }
        }
      }
    },
    "signature_algorithm": {
      "type": [
        "string",
        "null"
      ]
    },
    "public_key_jwk": {
      "type": [
        "object",
        "null"
      ]
    },
    "evidence_bag_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "test_kit": {
      "type": [
        "string",
        "null"
      ]
    },
    "reagent_qr": {
      "type": [
        "string",
        "null"
      ]
    },
    "reagent": {
      "type": [
        "object",
        "null"
      ]
    },
    "anti_spoof": {
      "type": [
        "object",
        "null"
      ]
    },
    "color_distance": {
      "type": [
        "object",
        "null"
      ]
    },
    "roi": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "features": {
      "type": [
        "object",
        "null"
      ]
    },
    "sync_status": {
      "type": "string",
      "enum": [
        "QUEUED",
        "SYNCING",
        "SYNCED",
        "FAILED"
      ]
    },
    "integrity_status": {
      "type": "string"
    },
    "analysis_status": {
      "type": "string"
    },
    "fsl_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "laboratory_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "sync_receipt": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "$comment": "Evidence records are field records; substance-level interpretation remains presumptive/inconclusive until kit-specific forensic validation."
}
